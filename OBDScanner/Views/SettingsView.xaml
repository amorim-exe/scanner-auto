<UserControl x:Class="OBD2Scanner.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource TextBrush}">

    <UserControl.Resources>

        <Style TargetType="ComboBoxItem">

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>


                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}"/>

                            </Trigger>


                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style TargetType="ComboBox">

            <Setter Property="Background"
                    Value="{DynamicResource BackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="8,0"/>

        </Style>

    </UserControl.Resources>

    <Grid Margin="32">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,28">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="AutoScan"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>

                <TextBlock Text=" SETTINGS"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

            </StackPanel>

            <TextBlock Text="Application and scanner configuration"
                       FontSize="11"
                       Margin="0,5,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="22"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="CONNECTION"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>


                    <TextBlock Text="Serial communication"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource TextBrush}"/>


                    <TextBlock Text="Configure the communication parameters used by the ELM327 adapter."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,6,0,20"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>


                    <TextBlock Text="BAUD RATE"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>


                    <ComboBox Height="34"
                              Margin="0,7,0,18"
                              SelectedIndex="0">

                        <ComboBoxItem Content="38400" Foreground="{DynamicResource TextBrush}"/>
                        <ComboBoxItem Content="9600" Foreground="{DynamicResource TextBrush}"/>
                        <ComboBoxItem Content="115200" Foreground="{DynamicResource TextBrush}"/>

                    </ComboBox>


                    <TextBlock Text="PROTOCOL"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>


                    <ComboBox Height="34"
                              Margin="0,7,0,0"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Automatic" Foreground="{DynamicResource TextBrush}"/>
                        <ComboBoxItem Content="ISO 15765-4 CAN" Foreground="{DynamicResource TextBrush}"/>
                        <ComboBoxItem Content="ISO 9141-2" Foreground="{DynamicResource TextBrush}"/>
                        <ComboBoxItem Content="ISO 14230-4" Foreground="{DynamicResource TextBrush}"/>

                    </ComboBox>

                </StackPanel>

            </Border>


            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="22"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="APPLICATION"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>


                    <TextBlock Text="Interface"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource TextBrush}"/>


                    <TextBlock Text="Application interface preferences."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,6,0,22"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>


                    <Border Height="52"
                            Padding="12"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,10">

                        <Grid>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Theme"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="Use the global application theme"
                                           FontSize="9"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <Border Height="52"
                            Padding="12"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Live data"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextBrush}"/>

                            <TextBlock Text="Update vehicle parameters continuously"
                                       FontSize="9"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>