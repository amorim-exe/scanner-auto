<UserControl x:Class="OBD2Scanner.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,4,0,20">

            <StackPanel>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="AutoScan"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <TextBlock Text=" DIAGNOSTICS"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>

                </StackPanel>

                <TextBlock Text="Diagnostic trouble codes stored in the ECU"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="ReadButton"
                        Content="SCAN"
                        Width="90"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="ReadButton_Click"/>

                <Button x:Name="ClearButton"
                        Content="CLEAR"
                        Width="90"
                        Height="36"
                        Click="ClearButton_Click"/>

            </StackPanel>

        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,15">

                    <TextBlock Text="FAULT CODES"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <TextBlock x:Name="StatusText"
                               Text="No scan performed"
                               HorizontalAlignment="Right"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                </Grid>

                <ListBox x:Name="CodesList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}"
                         FontSize="14"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>