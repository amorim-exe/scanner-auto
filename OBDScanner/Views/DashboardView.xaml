<UserControl x:Class="OBD2Scanner.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,4,0,20">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="AutoScan"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleBrush}"/>

                <TextBlock Text=" DASHBOARD"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

            </StackPanel>

            <TextBlock Text="Vehicle overview and live engine data"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,0"/>

        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="1.3*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="30"
                    Margin="0,0,0,14">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ENGINE RPM"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"/>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <TextBlock x:Name="RpmText"
                                       Text="---"
                                       FontSize="76"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBrush}"/>

                            <TextBlock Text="RPM"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="12,0,0,16"/>

                        </StackPanel>

                        <ProgressBar x:Name="RpmProgress"
                                     Width="520"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="8000"
                                     Value="0"
                                     Margin="0,12,0,0"/>

                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="LIVE ENGINE DATA"
                               FontSize="9"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>

                </Grid>

            </Border>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,7,0">

                    <StackPanel>

                        <TextBlock Text="VEHICLE SPEED"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">

                            <TextBlock x:Name="SpeedText"
                                       Text="---"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>

                            <TextBlock Text="km/h"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="7,0,0,5"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="7,0">

                    <StackPanel>

                        <TextBlock Text="COOLANT"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">

                            <TextBlock x:Name="CoolantText"
                                       Text="---"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>

                            <TextBlock Text="°C"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="7,0,0,5"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="7,0">

                    <StackPanel>

                        <TextBlock Text="ENGINE LOAD"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">

                            <TextBlock x:Name="LoadText"
                                       Text="---"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>

                            <TextBlock Text="%"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="7,0,0,5"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <Border Grid.Column="3"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="7,0,0,0">

                    <StackPanel>

                        <TextBlock Text="FUEL ECONOMY"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">

                            <TextBlock x:Name="FuelEconomyText"
                                       Text="---"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBrush}"/>

                            <TextBlock Text="km/L"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="7,0,0,5"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>