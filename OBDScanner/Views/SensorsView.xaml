<UserControl x:Class="OBD2Scanner.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,4,0,20">

            <Grid>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="AutoScan"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleBrush}"/>

                    <TextBlock Text=" SENSORS"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>

                </StackPanel>

                <Button Content="EXPORT DATA"
                        Width="120"
                        Height="36"
                        HorizontalAlignment="Right"
                        Style="{DynamicResource ActionButton}"/>

            </Grid>

            <TextBlock Text="Live OBD2 sensor parameters"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,0"/>

        </StackPanel>


        <!-- SENSOR GRID -->
        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- THROTTLE -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,7,7"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="THROTTLE POSITION"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <TextBlock x:Name="ThrottleText"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="%"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,5"/>

                    </StackPanel>

                    <ProgressBar x:Name="ThrottleProgress"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Margin="0,8,0,0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource BorderBrush}"/>

                </StackPanel>

            </Border>


            <!-- MAP -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Margin="7,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="MAP PRESSURE"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <TextBlock x:Name="MapText"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="kPa"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,5"/>

                    </StackPanel>

                    <ProgressBar x:Name="MapProgress"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="255"
                                 Value="0"
                                 Margin="0,8,0,0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource BorderBrush}"/>

                </StackPanel>

            </Border>


            <!-- IAT -->
            <Border Grid.Row="0"
                    Grid.Column="2"
                    Margin="7,0,0,7"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="INTAKE AIR TEMP"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <TextBlock x:Name="IatText"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="°C"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,5"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- STFT -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,7,7,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="STFT BANK 1"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <TextBlock x:Name="StftText"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}"/>

                        <TextBlock Text="%"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,5"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- LTFT -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Margin="7,7,7,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="LTFT BANK 1"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <TextBlock x:Name="LtftText"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}"/>

                        <TextBlock Text="%"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,5"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- O2 -->
            <Border Grid.Row="1"
                    Grid.Column="2"
                    Margin="7,7,0,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="OXYGEN SENSOR 1"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <TextBlock x:Name="O2Text"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}"/>

                        <TextBlock Text="V"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,5"/>

                    </StackPanel>

                    <TextBlock x:Name="O2TrimText"
                               Text="Trim: ---"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Border>


            <!-- MAF -->
            <Border Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,7,7,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="MAF"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <TextBlock x:Name="MafText"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="g/s"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,5"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- FUEL RATE -->
            <Border Grid.Row="2"
                    Grid.Column="1"
                    Margin="7,7,7,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="FUEL RATE"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <TextBlock x:Name="FuelRateText"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="L/h"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,5"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- FUEL CONSUMPTION -->
            <Border Grid.Row="2"
                    Grid.Column="2"
                    Margin="7,7,0,0"
                    Padding="20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <TextBlock Text="FUEL CONSUMPTION"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <TextBlock x:Name="FuelConsumptionText"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}"/>

                        <TextBlock Text="L/h"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,5"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>