<Window x:Class="OBD2Scanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoScan"
        Height="800"
        Width="1280"
        MinHeight="700"
        MinWidth="1050"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Inter"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- COLORS -->
        <!-- ===================================================== -->

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#090B0D"/>

        <SolidColorBrush x:Key="SurfaceBrush"
                         Color="#111417"/>

        <SolidColorBrush x:Key="SurfaceHoverBrush"
                         Color="#1A1F22"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#292F33"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#D4E40F"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#EBF1F5"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#8B9399"/>

        <SolidColorBrush x:Key="SuccessBrush"
                         Color="#22C55E"/>

        <SolidColorBrush x:Key="DangerBrush"
                         Color="#EF4444"/>

        <SolidColorBrush x:Key="TitleBrush"
                         Color="#D4E40F"/>


        <!-- ===================================================== -->
        <!-- WINDOW BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="WindowButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="38"/>

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource SurfaceHoverBrush}"/>

                    <Setter Property="Foreground"
                            Value="{DynamicResource TextBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- CLOSE BUTTON -->

        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource WindowButton}">

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#331F1F"/>

                    <Setter Property="Foreground"
                            Value="#FF6B6B"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- NAVIGATION -->
        <!-- ===================================================== -->

        <Style x:Key="NavButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Margin"
                    Value="0,2"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource SurfaceHoverBrush}"/>

                    <Setter Property="Foreground"
                            Value="{DynamicResource TextBrush}"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource SurfaceBrush}"/>

                    <Setter Property="Foreground"
                            Value="{DynamicResource AccentBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- TOP BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="TopButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource SurfaceHoverBrush}"/>

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- MODULE CARD -->
        <!-- ===================================================== -->

        <Style x:Key="ModuleCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

        </Style>


        <!-- ===================================================== -->
        <!-- ACTION BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="ActionButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource SurfaceHoverBrush}"/>

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- COMBOBOX ITEM -->
        <!-- ===================================================== -->

        <Style x:Key="PortComboItem"
               TargetType="ComboBoxItem">

            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- WINDOW FRAME -->
    <!-- ========================================================= -->

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="64"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="30"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">

                <Grid Margin="24,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="260"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <!-- BRAND -->

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="{Binding [app_title]}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBrush}"/>

                        </StackPanel>

                        <TextBlock Text="{Binding [app_subtitle]}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,2,0,0"/>

                    </StackPanel>


                    <!-- TOP NAV -->

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <Button Content="{Binding [dashboard]}"
                                Style="{StaticResource NavButton}"
                                Width="105"
                                HorizontalContentAlignment="Center"
                                Click="DashboardButton_Click"/>

                        <Button Content="{Binding [diagnostics]}"
                                Style="{StaticResource NavButton}"
                                Width="105"
                                HorizontalContentAlignment="Center"
                                Click="DiagnosticsButton_Click"/>

                        <Button Content="{Binding [sensors]}"
                                Style="{StaticResource NavButton}"
                                Width="90"
                                HorizontalContentAlignment="Center"
                                Click="SensorsButton_Click"/>

                    </StackPanel>


                    <!-- WINDOW CONTROLS -->

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">


                        <!-- LANGUAGE -->

                        <!--<Button Content="🇧🇷"
                                Width="36"
                                Margin="0,0,4,0"
                                Style="{StaticResource TopButton}"
                                FontSize="14"
                                Click="Portuguese_Click"/>-->

                        <!--<Button Content="🇺🇸"
                                Width="36"
                                Margin="0,0,4,0"
                                Style="{StaticResource TopButton}"
                                FontSize="14"
                                Click="English_Click"/>-->

                        <!--<Button Content="🇪🇸"
                                Width="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource TopButton}"
                                FontSize="14"
                                Click="Spanish_Click"/>-->


                        <!-- THEME -->

                        <!--<Button x:Name="ThemeButton"
                                Content="☀"
                                Width="36"
                                Margin="0,0,8,0"
                                Style="{StaticResource TopButton}"
                                FontSize="15"
                                Click="Theme_Click"/>-->


                        <!-- MINIMIZE -->

                        <Button Content="—"
                                Style="{StaticResource WindowButton}"
                                Click="MinimizeButton_Click"/>


                        <!-- MAXIMIZE -->

                        <Button x:Name="MaximizeButton"
                                Content="□"
                                Style="{StaticResource WindowButton}"
                                Click="MaximizeButton_Click"/>


                        <!-- CLOSE -->

                        <Button Content="×"
                                Style="{StaticResource CloseButton}"
                                Click="CloseButton_Click"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- MAIN AREA -->
            <!-- ================================================= -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="230"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- SIDEBAR -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">

                    <Grid Margin="18">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="1"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- CONNECTION -->

                        <TextBlock Grid.Row="0"
                                   Text="{Binding [connection]}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="4,5,0,12"/>


                        <!-- CONNECTION CARD -->

                        <Border Grid.Row="1"
                                Style="{StaticResource ModuleCard}"
                                Padding="14"
                                Margin="0,0,0,18">

                            <StackPanel>


                                <StackPanel Orientation="Horizontal">

                                    <TextBlock x:Name="StatusIndicator"
                                               Text="●"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock x:Name="StatusText"
                                               Text="{Binding [status_disconnected]}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="7,0,0,0"/>

                                </StackPanel>


                                <TextBlock Text="ELM327"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,0"/>


                                <TextBlock Text="Serial adapter"
                                           FontSize="9"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,2,0,12"/>


                                <!-- PORT -->

                                <ComboBox x:Name="PortComboBox"
                                          Height="34"
                                          Background="{DynamicResource BackgroundBrush}"
                                          Foreground="{DynamicResource TextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          BorderThickness="1"
                                          Padding="8,0"
                                          Margin="0,0,0,8">

                                    <ComboBox.ItemContainerStyle>
                                        <StaticResource ResourceKey="PortComboItem"/>
                                    </ComboBox.ItemContainerStyle>

                                </ComboBox>


                                <!-- BUTTONS -->

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <Button Grid.Column="0"
                                            Content="{Binding [refresh]}"
                                            Height="32"
                                            Margin="0,0,4,0"
                                            Style="{StaticResource ActionButton}"
                                            Click="RefreshButton_Click"/>


                                    <Button x:Name="ConnectButton"
                                            Grid.Column="1"
                                            Content="{Binding [connect]}"
                                            Height="32"
                                            Margin="4,0,0,0"
                                            Style="{StaticResource ActionButton}"
                                            Click="ConnectButton_Click"/>

                                </Grid>

                            </StackPanel>

                        </Border>


                        <!-- DIVIDER -->

                        <Border Grid.Row="2"
                                Background="{DynamicResource BorderBrush}"
                                Height="1"/>


                        <!-- NAVIGATION LABEL -->

                        <TextBlock Grid.Row="3"
                                   Text="NAVIGATION"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="4,18,0,8"/>


                        <!-- NAVIGATION -->

                        <StackPanel Grid.Row="4">


                            <!-- DASHBOARD -->

                            <Button x:Name="DashboardButton"
                                    Style="{StaticResource NavButton}"
                                    Background="{DynamicResource SurfaceHoverBrush}"
                                    Click="DashboardButton_Click">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="💻"
                                               Width="28"
                                               Foreground="{DynamicResource TitleBrush}"
                                               FontSize="15"/>

                                    <TextBlock Text="{Binding [dashboard]}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- DIAGNOSTICS -->

                            <Button x:Name="DiagnosticsButton"
                                    Style="{StaticResource NavButton}"
                                    Click="DiagnosticsButton_Click">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="⚡"
                                               Width="28"
                                               Foreground="{DynamicResource TitleBrush}"
                                               FontSize="14"/>

                                    <TextBlock Text="{Binding [diagnostics]}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- SENSORS -->

                            <Button x:Name="SensorsButton"
                                    Style="{StaticResource NavButton}"
                                    Click="SensorsButton_Click">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="👁️"
                                               Width="28"
                                               Foreground="{DynamicResource TitleBrush}"
                                               FontSize="15"/>

                                    <TextBlock Text="{Binding [sensors]}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- SETTINGS -->

                            <Button Style="{StaticResource NavButton}"
                                    Click="SettingsButton_Click">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="⚙"
                                               Width="28"
                                               Foreground="{DynamicResource TitleBrush}"
                                               FontSize="14"/>

                                    <TextBlock Text="{Binding [settings]}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>


                        <!-- SIDEBAR FOOTER -->

                        <StackPanel Grid.Row="5"
                                    Margin="4,0,0,4">

                            <TextBlock Text="AutoScan"
                                       FontSize="9"
                                       Foreground="{DynamicResource TitleBrush}"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="ELM327"
                                       FontSize="9"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- CONTENT -->
                <!-- ================================================= -->

                <ContentControl x:Name="MainContent"
                                Grid.Column="1"
                                Margin="28"/>

            </Grid>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">

                <Grid Margin="24,0">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                        <TextBlock Text="AutoScan"
                                   FontSize="9"
                                   Foreground="{DynamicResource TitleBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="v1.0.0"
                                   FontSize="9"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>