<Window x:Class="OBD2Scanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoScan"
        Height="800"
        Width="1280"
        MinHeight="700"
        MinWidth="1050"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Inter"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0D0F"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111417"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#191E23"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#252A2F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4444"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8EAED"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7D858D"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#00CC66"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF4444"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModuleCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding [app_title]}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <TextBlock Text="{Binding [app_subtitle]}"
                               FontSize="9"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <Button Content="{Binding [dashboard]}"
                            Style="{StaticResource NavButton}"
                            Width="105"
                            HorizontalContentAlignment="Center"
                            Click="DashboardButton_Click"/>

                    <Button Content="{Binding [diagnostics]}"
                            Style="{StaticResource NavButton}"
                            Width="105"
                            HorizontalContentAlignment="Center"
                            Click="DiagnosticsButton_Click"/>

                    <Button Content="{Binding [sensors]}"
                            Style="{StaticResource NavButton}"
                            Width="90"
                            HorizontalContentAlignment="Center"
                            Click="SensorsButton_Click"/>

                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="🇧🇷"
                            Width="36"
                            Margin="0,0,4,0"
                            Style="{StaticResource TopButton}"
                            FontSize="14"
                            Click="Portuguese_Click"/>

                    <Button Content="🇺🇸"
                            Width="36"
                            Margin="0,0,4,0"
                            Style="{StaticResource TopButton}"
                            FontSize="14"
                            Click="English_Click"/>

                    <Button Content="🇪🇸"
                            Width="36"
                            Margin="0,0,8,0"
                            Style="{StaticResource TopButton}"
                            FontSize="14"
                            Click="Spanish_Click"/>

                    <Button x:Name="ThemeButton"
                            Content="☀"
                            Width="36"
                            Style="{StaticResource TopButton}"
                            FontSize="15"
                            Click="Theme_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">

                <Grid Margin="18">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding [connection]}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="4,5,0,12"/>

                    <Border Grid.Row="1"
                            Style="{StaticResource ModuleCard}"
                            Padding="14"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock x:Name="StatusIndicator"
                                           Text="●"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <TextBlock x:Name="StatusText"
                                           Text="{Binding [status_disconnected]}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="7,0,0,0"/>

                            </StackPanel>

                            <TextBlock Text="ELM327"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,14,0,0"/>

                            <TextBlock Text="Serial adapter"
                                       FontSize="9"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,2,0,12"/>

                            <ComboBox x:Name="PortComboBox"
          Height="34"
          Background="{DynamicResource BackgroundBrush}"
          Foreground="{DynamicResource TextBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          Padding="8,0"
          Margin="0,0,0,8">

                                <ComboBox.Resources>

                                    <Style TargetType="ComboBoxItem">

                                        <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}"/>

                                        <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

                                        <Setter Property="Padding"
                    Value="10,8"/>

                                        <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

                                        <Setter Property="Template">

                                            <Setter.Value>

                                                <ControlTemplate TargetType="ComboBoxItem">

                                                    <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                                                        <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                                                    </Border>

                                                    <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver"
                                     Value="True">

                                                            <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>

                                                            <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}"/>

                                                        </Trigger>

                                                        <Trigger Property="IsSelected"
                                     Value="True">

                                                            <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>

                                                            <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}"/>

                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>

                                            </Setter.Value>

                                        </Setter>

                                    </Style>

                                </ComboBox.Resources>

                            </ComboBox>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding [refresh]}"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource ActionButton}"
                                        Click="RefreshButton_Click"/>

                                <Button x:Name="ConnectButton"
                                        Grid.Column="1"
                                        Content="{Binding [connect]}"
                                        Height="32"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource ActionButton}"
                                        Click="ConnectButton_Click"/>

                            </Grid>

                        </StackPanel>

                    </Border>

                    <Border Grid.Row="2"
                            Background="{DynamicResource BorderBrush}"
                            Height="1"/>

                    <TextBlock Grid.Row="3"
                               Text="NAVIGATION"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="4,18,0,8"/>

                    <StackPanel Grid.Row="4">

                        <Button x:Name="DashboardButton"
                                Style="{StaticResource NavButton}"
                                Background="{DynamicResource SurfaceHoverBrush}"
                                Click="DashboardButton_Click">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◉"
                                           Width="28"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="15"/>
                                <TextBlock Text="{Binding [dashboard]}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                        </Button>

                        <Button x:Name="DiagnosticsButton"
                                Style="{StaticResource NavButton}"
                                Click="DiagnosticsButton_Click">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡"
                                           Width="28"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="14"/>
                                <TextBlock Text="{Binding [diagnostics]}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                        </Button>

                        <Button x:Name="SensorsButton"
                                Style="{StaticResource NavButton}"
                                Click="SensorsButton_Click">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈"
                                           Width="28"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="15"/>
                                <TextBlock Text="{Binding [sensors]}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                        </Button>

                        <Button Style="{StaticResource NavButton}"
                                Click="SettingsButton_Click">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙"
                                           Width="28"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="14"/>
                                <TextBlock Text="{Binding [settings]}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                        </Button>

                    </StackPanel>

                    <StackPanel Grid.Row="5"
                                Margin="4,0,0,4">

                        <TextBlock Text="AutoScan"
                                   FontSize="9"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="ELM327"
                                   FontSize="9"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

            <ContentControl x:Name="MainContent"
                            Grid.Column="1"
                            Margin="28"/>

        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Grid Margin="24,0">

                <TextBlock x:Name="StatusDescription"
                           Text="Vehicle diagnostic system"
                           FontSize="9"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">

                    <TextBlock Text="AutoScan"
                               FontSize="9"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"/>

                    <TextBlock Text="v1.0.0"
                               FontSize="9"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>